# Live tests (ggsel_py/tests/live): copy to `.env.test` (it is not committed) and fill in.
# Run: python -m pytest -m live ggsel_py/tests/live
# Tests whose variables are empty are skipped.

# V2 API key: https://seller.ggsel.com/settings (header Authorization)
GGSEL_API_KEY=

# V1: either a ready token...
GGSEL_TOKEN=
# ...or the seller ID and the API secret, then the token is received by `api_login`.
# GGSEL_SELLER_ID is also needed by `all_products_for_seller`.
GGSEL_SELLER_ID=
GGSEL_API_SECRET=

# Unique code of the test order 33455315 (used by `check_unique_code`)
GGSEL_LIVE_UNIQUE_CODE=

# 1 — also send a real message to the chat of order 33455315
GGSEL_LIVE_SEND_MESSAGE=0
# Text of that message (optional)
GGSEL_LIVE_MESSAGE=
